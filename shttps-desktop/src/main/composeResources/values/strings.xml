    <!-- WebSocket channels -->
    <string name="channels">WebSocket channels</string>
    <string name="enable_channels">Enable WebSocket channels</string>
    <string name="enable_channels_info">Channels are lightweight WebSocket rooms served under /api/channels. Clients connect to /api/channels/{id}/connect and either relay messages to each other (Echo mode) or share one JSON document the server keeps in sync (Shared state mode).\n\nNothing is stored on disk: channels and their state live only while the server runs.\n\nChannels obey the same authorization as the rest of the API. When authorization is enabled, a user needs channel permissions before they can use a channel - grant these per user or per role on the users screen.</string>
    <string name="channels_configuration">Channels configuration</string>
    <string name="channels_screen_hint">Channels defined here exist for as long as the server runs, whether or not anybody is connected.</string>
    <string name="allow_dynamic_channel_creation">Let clients create channels</string>
    <string name="allow_dynamic_channel_creation_info">When enabled, clients may create channels at runtime with POST /api/channels (the "Create channels" permission is still required). Such channels disappear once they have been empty longer than the idle timeout. Channels defined on this screen are never affected.</string>
    <string name="predefined_channels">Predefined channels</string>
    <string name="add_channel">Add channel</string>
    <string name="no_channels_configured">No channels configured</string>

    <string name="channel_limits">Limits</string>
    <string name="channel_limits_summary">Up to %1$d dynamic channels, %2$d participants, %3$d msg/s, %4$d KiB</string>
    <string name="channel_limits_description">These limits apply to all channels. Changing them restarts the server, which disconnects anybody currently connected.</string>
    <string name="channel_limits_invalid">Every limit must be a whole number</string>
    <string name="channel_max_dynamic_channels">Max channels created by clients</string>
    <string name="channel_max_dynamic_channels_hint">Maximum number of channels clients may create at runtime</string>
    <string name="channel_max_participants_per_channel">Max participants per channel</string>
    <string name="channel_max_participants_per_channel_hint">Default participant limit per channel; a channel may set its own</string>
    <string name="channel_idle_timeout">Idle timeout (minutes)</string>
    <string name="channel_idle_timeout_hint">Minutes an empty client-created channel survives before it is removed. 0 keeps such channels forever.</string>
    <string name="channel_message_rate_limit_global">Message rate limit (per second)</string>
    <string name="channel_message_rate_limit_global_hint">Incoming messages per second per connection; a channel may set its own. 0 turns throttling off.</string>
    <string name="channel_max_message_size">Max message size (KiB)</string>
    <string name="channel_max_message_size_hint">Largest message accepted on any channel. An oversized message closes that connection.</string>

