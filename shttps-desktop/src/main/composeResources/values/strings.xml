    <string name="channel_mode">Mode</string>
    <string name="channel_mode_echo">Echo - relay messages</string>
    <string name="channel_mode_state">Shared state</string>
    <string name="channel_mode_echo_description">Every message a participant sends is relayed to the others as-is. Suitable for chat, notifications and game moves.</string>
    <string name="channel_mode_state_description">The channel holds one JSON document. Participants change it with set / merge / delete / increment / push commands and receive each other\'s changes; a newly connected client gets the current document.</string>
    <string name="channel_initial_state">Initial state (JSON object)</string>
    <string name="channel_initial_state_description">The document the channel starts from every time the server starts. Leave empty for an empty object.</string>
    <string name="channel_initial_state_hint">{"players": {}}</string>
    <string name="channel_initial_state_invalid">Initial state must be a valid JSON object</string>
    <string name="channel_max_participants">Max participants</string>
    <string name="channel_max_participants_description">Leave empty to use the server-wide limit.</string>
    <string name="channel_max_participants_invalid">Max participants must be a positive number, or empty</string>
    <string name="channel_message_rate_limit">Message rate limit (per second)</string>
    <string name="channel_message_rate_limit_description">Leave empty to use the server-wide limit. Enter 0 to leave this channel unthrottled.</string>
    <string name="channel_message_rate_limit_invalid">Message rate limit cannot be negative</string>
    <string name="channel_guests_allowed">Allow guests</string>
    <string name="channel_guests_allowed_description">When off, only signed-in users may connect, even if guest access is configured for the rest of the server.</string>
    <string name="channel_notify_presence">Announce joins and leaves</string>
    <string name="channel_deletable">Allow deletion over the API</string>
    <string name="channel_deletable_description">Allows DELETE /api/channels/{id} to remove this channel until the server is restarted, for a client holding the "Delete channels" permission.</string>
    <string name="channel_binary_allowed">Relay binary messages</string>
    <string name="channel_binary_allowed_description">Passes raw binary frames through to the other participants untouched, alongside ordinary messages. The size cap is the server-wide one under Limits, shared by every channel.</string>
